{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pos-multi-tenant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "preview_urls": true,
  "minify": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "APP_ENV": "development",
    "BASE_DOMAIN": "example.test",
    "LOG_LEVEL": "debug",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pos-multi-tenant-development",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "pos-multi-tenant-development",
    },
  ],
}
