{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "build": "wrangler deploy --dry-run --outdir ../../.wrangler-build",
    "typecheck": "tsc --project tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "db:validate": "bash scripts/validate-migrations.sh",
    "db:migrate:local": "wrangler d1 migrations apply pos-multi-tenant-development --local"
  },
  "dependencies": {
    "@pos/contracts": "*",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "drizzle-kit": "0.31.10",
    "wrangler": "4.123.0"
  }
}
