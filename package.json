{
  "name": "pos-multi-tenant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant retail and pharmacy POS SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @pos/api",
    "dev:web": "npm run dev --workspace @pos/web",
    "build": "npm run build:web && npm run build:api",
    "build:api": "npm run build --workspace @pos/api",
    "build:web": "npm run build --workspace @pos/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate --workspace @pos/api",
    "db:check": "npm run db:check --workspace @pos/api",
    "db:validate": "npm run db:validate --workspace @pos/api",
    "db:migrate:local": "npm run db:migrate:local --workspace @pos/api",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run db:check && npm run db:validate && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
